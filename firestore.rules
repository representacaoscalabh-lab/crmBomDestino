rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function approved() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    function admin() {
      return approved()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function customerMigration() {
      return exists(/databases/$(database)/documents/settings/read_optimization)
        && get(/databases/$(database)/documents/settings/read_optimization).data.get('customerMigration', false) == true;
    }

    function customerReservations() {
      return exists(/databases/$(database)/documents/settings/read_optimization)
        && get(/databases/$(database)/documents/settings/read_optimization).data.get('customerReservations', false) == true;
    }

    function validCustomerReservation(customerId) {
      let normalized = request.resource.data.get('documentNormalized', '');
      let raw = request.resource.data.get('document', '');
      return normalized is string && raw is string
        && normalized == raw.replace('[^0-9]', '')
        && (normalized == '' || (normalized.matches('^[0-9]{14}$')
          && getAfter(/databases/$(database)/documents/customer_documents/$(normalized)).data.customerId == customerId));
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || admin());
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'user';
      allow update, delete: if admin();
    }

    match /access_requests/{userId} {
      allow read: if admin() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending';
      allow update, delete: if admin();
    }

    match /customers/{customerId} {
      allow read: if approved();
      allow create, update: if approved() && !customerMigration()
        && (!customerReservations() || validCustomerReservation(customerId));
      allow delete: if approved() && !customerMigration()
        && (!customerReservations() || resource.data.get('documentNormalized', '') == ''
          || !existsAfter(/databases/$(database)/documents/customer_documents/$(resource.data.documentNormalized)));
    }

    match /customer_documents/{normalized} {
      allow read: if approved();
      allow create, update: if approved() && !customerMigration()
        && normalized.matches('^[0-9]{14}$')
        && request.resource.data.keys().hasOnly(['customerId'])
        && request.resource.data.customerId is string
        && (!exists(/databases/$(database)/documents/customer_documents/$(normalized))
          || resource.data.customerId == request.resource.data.customerId)
        && getAfter(/databases/$(database)/documents/customers/$(request.resource.data.customerId)).data.documentNormalized == normalized;
      allow delete: if approved() && !customerMigration()
        && (!existsAfter(/databases/$(database)/documents/customers/$(resource.data.customerId))
          || getAfter(/databases/$(database)/documents/customers/$(resource.data.customerId)).data.get('documentNormalized', '') != normalized);
    }

    match /settings/read_optimization {
      allow read: if approved();
      allow write: if admin();
    }

    match /daily_orders/{id} {
      allow read: if approved();
      allow write: if false;
    }

    match /daily_bonifications/{id} {
      allow read: if approved();
      allow write: if false;
    }

    match /customer_groups/{groupId} {
      allow read, create, update, delete: if approved();
    }

    match /products/{productId} {
      allow read, create, update, delete: if approved();
    }

    match /orders/{orderId} {
      allow read, delete: if approved();
      allow create, update: if approved() && request.resource.data.status == "normal";
    }

    match /bonifications/{bonificationId} {
      allow read, create, update, delete: if approved();
    }

    match /goals/{goalId} {
      allow read, create, update, delete: if approved();
    }

    match /payment_terms/{termId} {
      allow read: if approved();
      allow create, update, delete: if admin();
    }

    match /sellers/{sellerId} {
      allow read: if approved();
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100;
    }

    match /settings/oesa_nova_safra {
      allow read: if approved();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['groupId', 'reportName', 'updatedAt'])
        && request.resource.data.groupId is string
        && (!('reportName' in request.resource.data)
          || (request.resource.data.reportName is string && request.resource.data.reportName.size() <= 100));
      allow delete: if admin();
    }

    match /settings/mart_minas {
      allow read: if approved();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['groupId', 'reportName', 'updatedAt'])
        && request.resource.data.groupId is string
        && (!('reportName' in request.resource.data)
          || (request.resource.data.reportName is string && request.resource.data.reportName.size() <= 100));
      allow delete: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
